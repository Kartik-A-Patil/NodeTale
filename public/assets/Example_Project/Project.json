{"id":"34e3b22f-5f7f-4087-aa59-631c286fd28f","name":"Example Project","activeBoardId":"1468f184-7e45-4a96-a5fa-075ec9b56ab0","variables":[{"id":"var-1766583819933","name":"trust_level","type":"number","value":0},{"id":"var-1766583828948","name":"signal_decoded","type":"boolean","value":false},{"id":"var-1766583836644","name":"facility_power","type":"boolean","value":false},{"id":"var-1766589194476","name":"player_name","type":"string","value":"John"}],"assets":[{"id":"asset-1766583597905","name":"facility_exterior_night.jpg","type":"image","url":"assets/images/facility_exterior_night.jpg","parentId":"folder-1766583561095"},{"id":"asset-1766583601308","name":"facility_hall_interior.jpg","type":"image","url":"assets/images/facility_hall_interior.jpg","parentId":"folder-1766583561095"},{"id":"asset-1766584360196-0","name":"final_signal_clear.wav","type":"audio","url":"assets/audio/final_signal_clear.wav","parentId":"folder-1766583577646"},{"id":"asset-1766584360209-1","name":"generator_startup.mp3","type":"audio","url":"assets/audio/generator_startup.mp3","parentId":"folder-1766583577646"},{"id":"asset-1766584360217-2","name":"low_hum_loop.mp3","type":"audio","url":"assets/audio/low_hum_loop.mp3","parentId":"folder-1766583577646"},{"id":"asset-1766584360227-3","name":"rain_soft_loop.mp3","type":"audio","url":"assets/audio/rain_soft_loop.mp3","parentId":"folder-1766583577646"},{"id":"asset-1766584360239-4","name":"signal_static_short.wav","type":"audio","url":"assets/audio/signal_static_short.wav","parentId":"folder-1766583577646"},{"id":"asset-1766602572324-0","name":"terminal_flicker.mp4","type":"video","url":"assets/video/terminal_flicker.mp4","parentId":"folder-1766602573566"}],"folders":[{"id":"folder-1766583561095","name":"images","parentId":null},{"id":"folder-1766583577646","name":"audio","parentId":null},{"id":"folder-1766602573566","name":"video","parentId":null}],"boards":[{"id":"1468f184-7e45-4a96-a5fa-075ec9b56ab0","name":"Main Chapter","nodes":[{"id":"node-1","type":"elementNode","position":{"x":-710,"y":-648},"data":{"label":"Start","content":"<p>Rain taps against the windshield as <strong>{{player_name}}</strong> stops the vehicle.</p>\n<p>The facility rises ahead—dark, silent, forgotten.</p>\n<p>Ten years ago, this place was abandoned.<br>\nAt least… that’s what the report said.</p>\n<h3></h3>","assets":["asset-1766583597905","asset-1766584360227-3"]},"width":427,"height":441},{"id":"node-1766584420036","type":"elementNode","position":{"x":-648,"y":-98},"data":{"label":"The Signal","content":"<p>A faint signal flickers on the communicator.</p>\n<p>Old encryption.<br>\nMilitary-grade.<br>\nSomeone wanted this to survive.</p>","assets":["asset-1766584360239-4"]},"width":466,"height":225},{"id":"node-1766584487653","type":"elementNode","position":{"x":143,"y":-414},"data":{"label":"Decoding the Signal","content":"<p>You filter the noise.<br>\nRebuild the fragments.</p>\n<div>A distorted voice cuts through:</div><p><br></p><p></p><blockquote><span style=\"background-color: transparent; font-size: 0.75rem; color: rgb(161, 161, 170); font-style: italic;\">“</span>{{player_name}}<span style=\"background-color: transparent; font-size: 0.75rem; color: rgb(161, 161, 170); font-style: italic;\">… if you’re hearing this… I didn’t make it out.”</span></blockquote><pre class=\"language-javascript\">signal_decoded <span class=\"token operator\">=</span> <span class=\"token boolean\">true</span></pre><pre class=\"language-javascript\">trust_level += 1</pre><p></p>"},"width":459,"height":270},{"id":"node-1766584590745","type":"elementNode","position":{"x":202,"y":-48},"data":{"label":"Turning Away","content":"<p>You shut the signal down.</p>\n<p>Some doors stay closed for a reason.<br>\nYou step forward anyway.</p>"},"width":328,"height":226},{"id":"node-1766584623643","type":"elementNode","position":{"x":880,"y":-527},"data":{"label":"Entrance Hall","content":"<p>The doors seal behind you.</p>\n<p>Dust floats in the emergency lights.<br>\nThe air smells old… recycled… controlled.</p>","assets":["asset-1766583601308","asset-1766584360217-2"]},"width":439,"height":393},{"id":"node-1766584698581","type":"elementNode","position":{"x":956,"y":48},"data":{"label":"Power Control Room","content":"<p>A control panel sits at the center of the room.</p>\n<p>Without power, this place is blind.<br>\nSo are you.</p>"},"width":333,"height":228},{"id":"node-1766584740875","type":"elementNode","position":{"x":1684,"y":-198},"data":{"label":"Power Restored","content":"<p>Generators roar awake.</p>\n<p>Lights flood the corridors.<br>\nSomewhere deeper inside… something reacts.</p>\n<h3></h3><pre class=\"language-javascript\">facility_power <span class=\"token operator\">=</span> <span class=\"token boolean\">true</span></pre><pre class=\"language-javascript\">trust_level += 1</pre>","assets":["asset-1766584360209-1"]},"width":287,"height":299},{"id":"node-1766584799689","type":"elementNode","position":{"x":1633,"y":268},"data":{"label":"Proceed in the dark","content":"<p>You rely on a narrow beam of light.</p>\n<p>Every shadow feels deliberate.<br>\nThe silence feels… aware.</p>"},"width":409,"height":216},{"id":"node-1766584884269","type":"elementNode","position":{"x":462,"y":69},"data":{"label":"Archive Room","content":"<p>Rows of servers line the walls.</p>\n<p>One terminal still breathes.</p>\n<p></p>The terminal unlocks automatically.<br>\nLogs reference <strong>{{player_name}}</strong> by name.","assets":["asset-1766602572324-0"]},"parentNode":"node-1766588283128","width":365,"height":380},{"id":"node-1766584938603","type":"elementNode","position":{"x":477,"y":520},"data":{"label":"Archive Room","content":"<p>Rows of servers line the walls.</p>\n<p>One terminal still breathes.</p>\n<p></p>The terminal requests clearance you don’t have.","assets":["asset-1766602572324-0"]},"parentNode":"node-1766588283128","width":365,"height":348},{"id":"node-1766584966507","type":"conditionNode","position":{"x":61,"y":558},"data":{"label":"Logic Check","content":"","branches":[{"id":"true","label":"If","condition":"signal_decoded == true"},{"id":"false","label":"Else","condition":""}]},"parentNode":"node-1766588283128","width":294,"height":104},{"id":"node-1766585089481","type":"elementNode","position":{"x":3594,"y":-172},"data":{"label":"Final Message","content":"<p>The truth assembles quietly.</p>\n<p>This facility wasn’t abandoned.<br>\nIt was sealed.</p>\n<p>To keep something from getting out.</p>\n<p>Your communicator lights up again.</p>\n<p>This time…<br>\nthe signal is clear.</p><blockquote>IT WAS NEVER ABANDONED STOP DO NOT TRUST THE SILENCE</blockquote><p></p>","assets":["asset-1766584360196-0"],"color":"#818cf8"},"width":445,"height":345},{"id":"node-1766587945416","type":"annotationNode","position":{"x":-985,"y":111},"data":{"label":"First Meaningful Choice","content":"Introduces player agency without locking the story into separate paths.","arrowDirection":"top-right"},"width":250,"height":110},{"id":"node-1766588002212","type":"annotationNode","position":{"x":656,"y":301},"data":{"label":"Environmental Consequences","content":"Demonstrates how choices can change atmosphere and tension instead of plot direction.","arrowDirection":"top-right"},"width":250,"height":134},{"id":"node-1766588203880","type":"commentNode","position":{"x":4055,"y":-124},"data":{"label":"","content":"","text":"The ending resolves the mystery while intentionally leaving the world open for expansion.","color":"#818cf8"},"width":315,"height":286,"zIndex":-10},{"id":"node-1766588233059","type":"commentNode","position":{"x":2530,"y":-306},"data":{"label":"","content":"","text":"Earlier choices determine how much truth the player can access here, without blocking story progression."},"width":250,"height":205,"zIndex":-10},{"id":"node-1766588283128","type":"sectionNode","position":{"x":2415,"y":-422},"data":{"label":"Archive Room","content":"","color":"#60a5fa"},"width":1049,"height":952,"zIndex":-1}],"edges":[{"id":"e-node-1-node-1766584420036-1766584463802","source":"node-1","target":"node-1766584420036"},{"id":"e-node-1766584420036-node-1766584487653-1766584576661","source":"node-1766584420036","target":"node-1766584487653"},{"id":"e-node-1766584420036-node-1766584590745-1766584604742","source":"node-1766584420036","target":"node-1766584590745"},{"id":"e-node-1766584590745-node-1766584623643-1766584688088","source":"node-1766584590745","target":"node-1766584623643"},{"id":"e-node-1766584487653-node-1766584623643-1766584691633","source":"node-1766584487653","target":"node-1766584623643"},{"id":"e-node-1766584623643-node-1766584698581-1766584738895","source":"node-1766584623643","target":"node-1766584698581"},{"id":"e-node-1766584698581-node-1766584740875-1766584829330","source":"node-1766584698581","target":"node-1766584740875"},{"id":"e-node-1766584698581-node-1766584799689-1766584830981","source":"node-1766584698581","target":"node-1766584799689"},{"id":"e-node-1766584740875-node-1766584966507-1766584978105","source":"node-1766584740875","target":"node-1766584966507"},{"id":"e-node-1766584799689-node-1766584966507-1766584980469","source":"node-1766584799689","target":"node-1766584966507"},{"id":"e-node-1766584966507-node-1766584884269-1766584984652","source":"node-1766584966507","target":"node-1766584884269","sourceHandle":"true"},{"id":"e-node-1766584966507-node-1766584938603-1766584985981","source":"node-1766584966507","target":"node-1766584938603","sourceHandle":"false"},{"id":"e-node-1766584938603-node-1766585089481-1766585140831","source":"node-1766584938603","target":"node-1766585089481"},{"id":"e-node-1766584884269-node-1766585089481-1766585143223","source":"node-1766584884269","target":"node-1766585089481"}]}],"coverImage":"assets/images/facility_exterior_night.jpg"}
