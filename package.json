{
  "name": "nodetale",
  "private": true,
  "version": "0.0.0",
  "description": "NodeTale is a visually programmable story and logic engine.",
  "author": "NodeTale",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "vite --config configs/vite.web.config.ts",
    "build": "vite build --config configs/vite.web.config.ts",
    "preview": "vite preview --config configs/vite.web.config.ts",
    "dev:electron": "electron-vite dev --config configs/electron.vite.config.ts -- --no-sandbox",
    "build:electron": "electron-vite build --config configs/electron.vite.config.ts",
    "preview:electron": "electron-vite preview --config configs/electron.vite.config.ts -- --no-sandbox",
    "clean": "node scripts/clean.js",
    "dist": "npm run build:electron && electron-builder",
    "dist:linux": "npm run build:electron && electron-builder --linux",
    "dist:win": "npm run build:electron && electron-builder --win",
    "dist:mac": "npm run build:electron && electron-builder --mac"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.5",
    "clsx": "^2.1.1",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "lucide-react": "^0.554.0",
    "prismjs": "^1.30.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.6",
    "reactflow": "^11.11.4",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.9.19",
    "electron": "^39.2.7",
    "electron-builder": "^26.4.0",
    "electron-vite": "^5.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
